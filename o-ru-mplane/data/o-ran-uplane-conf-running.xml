<user-plane-configuration xmlns="urn:o-ran:uplane-conf:1.0">
    <!-- Default test carrier for conformance testing -->
    <tx-array-carriers>
        <name>carrier-1</name>
        <absolute-frequency-center>3600000</absolute-frequency-center>
        <center-of-channel-bandwidth>25000</center-of-channel-bandwidth>
        <channel-bandwidth>56000</channel-bandwidth>
        <active>ACTIVE</active>
        <gain>0</gain>
        <downlink-radio-frame-offset>0</downlink-radio-frame-offset>
        <downlink-sfn-offset>0</downlink-sfn-offset>
    </tx-array-carriers>
    <rx-array-carriers>
        <name>carrier-1</name>
        <absolute-frequency-center>3600000</absolute-frequency-center>
        <center-of-channel-bandwidth>25000</center-of-channel-bandwidth>
        <channel-bandwidth>56000</channel-bandwidth>
        <active>ACTIVE</active>
        <gain-correction>0</gain-correction>
        <downlink-radio-frame-offset>0</downlink-radio-frame-offset>
        <downlink-sfn-offset>0</downlink-sfn-offset>
        <n-ta-offset>0</n-ta-offset>
    </rx-array-carriers>
</user-plane-configuration>
