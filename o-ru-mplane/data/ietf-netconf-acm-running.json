{
    "ietf-netconf-acm:nacm": {
      "enable-nacm": true,
      "read-default": "deny",
      "write-default": "deny",
      "exec-default": "deny",
      "enable-external-groups": true,
      "groups": {
        "group": [
          {"name": "sudo", "user-name": ["sudo", "admin", "demx8as6", "netconf"]},
          {"name": "nms", "user-name": ["nms", "nero"]},
          {"name": "fm-pm", "user-name": ["fm-pm", "filippa"]},
          {"name": "swm", "user-name": ["swm", "swami"]},
          {"name": "smo", "user-name": ["smo", "simone"]},
          {"name": "hybrid-odu", "user-name": ["hybrid-odu", "haydon"]},
          {"name": "carrier", "user-name": ["carrier", "carron"]}
        ]
      },
      "rule-list": [
        {
          "name": "nacm-default-deny-all-enforcement",
          "group": ["sudo", "nms", "fm-pm", "swm", "smo", "hybrid-odu", "carrier"],
          "rule": [
            {"name": "deny-password-read", "module-name": "o-ran-usermgmt", "path": "/o-ran-usermgmt:users/user/password", "access-operations": "read", "action": "deny", "comment": "Enforce nacm:default-deny-all on password leaf — must not appear in GET responses (WG4 3.1.8.x)"}
          ]
        },
        {
          "name": "sudo-rules",
          "group": ["sudo"],
          "rule": [
            {"name": "allow-all", "module-name": "*", "access-operations": "*", "action": "permit"}
          ]
        },
        {
          "name": "nms-rules",
          "group": ["nms"],
          "rule": [
            {"name": "deny-nacm-config", "module-name": "ietf-netconf-acm", "access-operations": "*", "action": "deny", "comment": "Non-sudo groups cannot mutate NACM config (STS 11.1.3.6 negative case 3a)"},
            {"name": "deny-usermgmt", "module-name": "o-ran-usermgmt", "access-operations": "*", "action": "deny", "comment": "NMS cannot manage users (3.1.8.3)"},
            {"name": "allow-all", "module-name": "*", "access-operations": "*", "action": "permit"}
          ]
        },
        {
          "name": "fm-pm-rules",
          "group": ["fm-pm"],
          "rule": [
            {"name": "deny-nacm-config", "module-name": "ietf-netconf-acm", "access-operations": "*", "action": "deny", "comment": "Non-sudo groups cannot mutate NACM config (STS 11.1.3.6 negative case 3a)"},
            {"name": "deny-processing-element", "module-name": "o-ran-processing-element", "access-operations": "*", "action": "deny", "comment": "FM-PM cannot configure processing elements (3.1.8.4)"},
            {"name": "allow-read", "module-name": "*", "access-operations": "read", "action": "permit"},
            {"name": "allow-exec", "module-name": "*", "access-operations": "exec", "action": "permit"}
          ]
        },
        {
          "name": "swm-rules",
          "group": ["swm"],
          "rule": [
            {"name": "deny-nacm-config", "module-name": "ietf-netconf-acm", "access-operations": "*", "action": "deny", "comment": "Non-sudo groups cannot mutate NACM config (STS 11.1.3.6 negative case 3a)"},
            {"name": "deny-fm-read", "module-name": "o-ran-fm", "access-operations": "read", "action": "deny", "comment": "SWM cannot read FM data (3.1.8.5)"},
            {"name": "allow-swm", "module-name": "o-ran-software-management", "access-operations": "*", "action": "permit"},
            {"name": "allow-read", "module-name": "*", "access-operations": "read", "action": "permit"},
            {"name": "allow-exec", "module-name": "*", "access-operations": "exec", "action": "permit"}
          ]
        },
        {
          "name": "smo-rules",
          "group": ["smo"],
          "rule": [
            {"name": "deny-nacm-config", "module-name": "ietf-netconf-acm", "access-operations": "*", "action": "deny", "comment": "Non-sudo groups cannot mutate NACM config (STS 11.1.3.6 negative case 3a)"},
            {"name": "deny-ecpri", "module-name": "o-ran-ecpri-delay", "access-operations": "create update delete", "action": "deny"},
            {"name": "deny-supervision-exec", "module-name": "o-ran-supervision", "access-operations": "exec", "action": "deny", "comment": "SMO cannot execute supervision RPCs (3.1.8.7)"},
            {"name": "allow-all", "module-name": "*", "access-operations": "*", "action": "permit"}
          ]
        },
        {
          "name": "hybrid-odu-rules",
          "group": ["hybrid-odu"],
          "rule": [
            {"name": "deny-nacm-config", "module-name": "ietf-netconf-acm", "access-operations": "*", "action": "deny", "comment": "Non-sudo groups cannot mutate NACM config (STS 11.1.3.6 negative case 3a)"},
            {"name": "deny-file-mgmt-exec", "module-name": "o-ran-file-management", "access-operations": "exec", "action": "deny", "comment": "Hybrid-ODU cannot execute file management RPCs (3.1.8.8)"},
            {"name": "allow-all", "module-name": "*", "access-operations": "*", "action": "permit"}
          ]
        },
        {
          "name": "carrier-rules",
          "group": ["carrier"],
          "rule": [
            {"name": "deny-nacm-config", "module-name": "ietf-netconf-acm", "access-operations": "*", "action": "deny", "comment": "Non-sudo groups cannot mutate NACM config (STS 11.1.3.6 negative case 3a)"},
            {"name": "deny-file-mgmt-exec", "module-name": "o-ran-file-management", "access-operations": "exec", "action": "deny", "comment": "Carrier cannot execute file management RPCs (3.1.8.9)"},
            {"name": "allow-all", "module-name": "*", "access-operations": "*", "action": "permit"}
          ]
        }
      ]
    }
  }
